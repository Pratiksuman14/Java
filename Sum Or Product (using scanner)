import java.util.*;
class Number
{
    //function to display sum or product
    void findSumOrProduct()
    {
      Scanner sc = new Scanner(System.in);
      System.out.println("Enter two numbers");
      int a = sc.nextInt();
      int b = sc.nextInt();
      if(a!=b)
      {
          int s = a+b;
          System.out.println("Sum ="+s);
      }
      else 
      {
          int p = a*b;
          System.out.println("Product ="+p);
      }
    }
}
