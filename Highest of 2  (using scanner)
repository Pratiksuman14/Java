import java.util.*;
class Number 
{
    //function to find highest 
    void findHighest()
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter two numbers");
        int n1 = sc.nextInt();
        int n2 = sc.nextInt();
        if(n1>n2)
        {
            System.out.println(n1+"Is the highest number");
        }
        else 
        {
            System.out.println(n2+"Is the highest number");
        }
    }
}
