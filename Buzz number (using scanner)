import java.util.*;
class Number 
{
    //function to find buzz number
    void findBuzz()
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter a number");
        double n = sc.nextDouble();
        if(n%7==0 || n%10==7)
        {
            System.out.println(n+  "is a buzz number");
        }
        else
        {
            System.out.println(n+ " is not a buzz number");
        }
    }
}
