import java.util.*;
class Highest
{
    //function to find the highest number
    void findHighest()
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter three numbers");
        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();
        int h = a;
        if(b>h)
        {
            h=b;
        }
        if(c>h)
        {
            h=c;
        }
        System.out.println("The Highest number =" +h);
    }
}
