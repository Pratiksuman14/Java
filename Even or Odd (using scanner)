import java.util.*;
class Number
{
    //function to find even or odd
    void findEvenOrOdd()
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter a number");
        int n = sc.nextInt();
        if(n%2==0)
        {
            System.out.println(n+"Is an even number");
        }
        else
        {
            System.out.println(n+"Is an odd number");
        }
    }
}
