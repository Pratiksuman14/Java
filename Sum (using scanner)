import java.util.*;
class Sum
{
    //function to find sum
    void findSum()
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the first number");
        int a = sc.nextInt();
        System.out.println("Enter the second number");
        int b = sc.nextInt();
        int s = a+b;
        System.out.println("Sum="+s);
    }
}
